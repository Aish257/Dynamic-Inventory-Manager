pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                dir('streamlit-app') {
                    bat 'python -m pip install -r requirements.txt'
                }
            }
        }

        stage('Run Streamlit') {
            steps {
                dir('streamlit-app') {
                    bat 'start "" streamlit run app.py --server.headless true'
                }
            }
        }
    }
}