pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                dir('streamlit-app') {
                    bat 'python -m pip install -r requirements.txt'
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                bat 'ssh -i C:/ProgramData/Jenkins/Aishwarya@2005.pem -o StrictHostKeyChecking=no ubuntu@13.203.226.182 "cd /home/ubuntu/Dynamic-Inventory-Manager && git pull origin main"'
            }
        }
    }
}